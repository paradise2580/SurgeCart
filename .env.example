# Root-level reference — actual services read from their own .env files.
# core-api/.env / reserve-gateway/.env / web env-config.js as appropriate.

# --- core-api ---
DB_URL=jdbc:postgresql://localhost:5432/surgecart
DB_USER=postgres
DB_PASSWORD=postgres
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-real-256-bit-secret-before-deploying
CORS_ORIGIN=http://localhost:4200

# --- reserve-gateway ---
RESERVATION_TTL_SECONDS=90

# --- payments (test mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev-webhook-secret
